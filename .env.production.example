# Production environment variables for Render / any Docker host.
# Do NOT commit real values. This file documents what to add in the dashboard.

# --- Rails ---
SECRET_KEY_BASE=generate-with: bundle exec rails secret
DEVISE_JWT_SECRET_KEY=generate-another-long-random-string
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
# Thruster (inside the Docker image) listens on HTTP_PORT. Set this to the
# port Render assigns to the service (Render's default is 10000).
# Thruster starts Puma on TARGET_PORT and overrides PORT for that child process,
# so the PORT line below is only a fallback if Thruster is bypassed.
HTTP_PORT=10000
TARGET_PORT=3000
PORT=10000

# --- Database (Supabase > Connect > Session pooler) ---
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Frontend origin(s) for CORS ---
FRONTEND_ORIGINS=https://YOUR-SITE.netlify.app

# --- First admin account (created by db:seed on boot) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password
# Set to true once if you ever want db:seed to overwrite the password.
ADMIN_RESET_PASSWORD=false

# --- Photo storage (Supabase > Storage > S3 access keys) ---
ACTIVE_STORAGE_SERVICE=supabase
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=YOUR_PROJECT_REGION
SUPABASE_S3_BUCKET=portfolio-media
